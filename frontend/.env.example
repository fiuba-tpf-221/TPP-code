# Copiá este archivo como .env y pegá tu Client ID de Google (Google Cloud Console).
# Sin este valor, el botón de Google se muestra pero avisa que falta configurarlo.
REACT_APP_GOOGLE_CLIENT_ID=

# Opcional: timeout de sesión en segundos (por defecto 1800 = 30 min). Útil para demostrarlo, ej. 20.
REACT_APP_SESSION_TIMEOUT_SECONDS=
