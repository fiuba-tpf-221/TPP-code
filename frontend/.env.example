# Copiá este archivo como .env (es solo tuyo: no se sube al repositorio).
# Las variables REACT_APP_* se incorporan al CONSTRUIR la app: después de cambiarlas hay que reconstruir
# (docker compose up -d --build frontend) o reiniciar `npm start`.

# ─── Modo de trabajo ───────────────────────────────────────────────────────────
# "mock"     = ambiente controlado: login, usuarios y panel Sistema simulados (no necesita Docker). Es el valor por defecto.
# "keycloak" = integración real: login con Keycloak y panel Sistema con los servicios reales.
REACT_APP_MODE=

# Solo para casos sueltos: true/false fuerza el panel Sistema simulado o real, sin importar el modo.
REACT_APP_SIMULATE_INFRA=

# ─── Keycloak (solo modo "keycloak") ───────────────────────────────────────────
# Vacío = mismo host que la app, puerto 8080, realm tpp-realm, cliente frontend-client.
REACT_APP_KEYCLOAK_URL=
REACT_APP_KEYCLOAK_REALM=
REACT_APP_KEYCLOAK_CLIENT_ID=

# ─── Otros ─────────────────────────────────────────────────────────────────────
# Timeout de sesión en segundos (por defecto 1800 = 30 min). Útil para demostrarlo, ej. 20.
REACT_APP_SESSION_TIMEOUT_SECONDS=

# URL del backend para el panel Sistema real. Vacío = mismo host que la app, puerto 8000.
REACT_APP_BACKEND_URL=

# Client ID de Google para el botón "Continuar con Google" del modo mock (Google Cloud Console).
# Vacío = el botón avisa que falta configurarlo.
REACT_APP_GOOGLE_CLIENT_ID=
