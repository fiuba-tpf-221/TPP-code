{
  "id": null,
  "uid": "tpp-monitoreo-base",
  "title": "CPU y memoria de contenedores",
  "description": "Consumo de CPU y memoria por contenedor Docker. Permite identificar qué servicios usan más recursos y cómo cambia su consumo en el tiempo.",
  "tags": [
    "tpp",
    "infra",
    "cadvisor"
  ],
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "CPU por contenedor",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-tpp"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-tpp"
          },
          "expr": "sum(rate(container_cpu_usage_seconds_total{id!=\"/\",image!=\"\"}[2m])) by (id, name, container_label_com_docker_compose_service) * 100",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 15,
            "gradientMode": "opacity"
          }
        }
      },
      "id": 1,
      "description": "100 % equivale a un núcleo lógico. Incluye los contenedores observados por cAdvisor."
    },
    {
      "type": "timeseries",
      "title": "Memoria de trabajo por contenedor",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-tpp"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-tpp"
          },
          "expr": "sum(container_memory_working_set_bytes{id!=\"/\",image!=\"\"}) by (id, name, container_label_com_docker_compose_service)",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 20,
            "gradientMode": "opacity"
          }
        }
      },
      "id": 2,
      "description": "Memoria de trabajo utilizada por cada contenedor, expresada en bytes. Permite comparar el consumo y detectar aumentos sostenidos."
    }
  ]
}
