POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=appdb
RABBITMQ_DEFAULT_USER=user
RABBITMQ_DEFAULT_PASS=password
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadminpassword
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
TRACING_ENABLED=true
TRACING_SERVICE_VERSION=0.1.0
TRACING_ENVIRONMENT=development
TRACING_SAMPLE_RATIO=1
TRACING_CONSOLE_EXPORT=false
# Volumen existente del Compose principal que la central monta en solo lectura.
MONITOR_POSTGRES_VOLUME=tpp-code_postgres_data
